import java.util.Scanner;

class MataKuliah {
    String nama;
    int sks;
    String nilaiHuruf;

    MataKuliah(String nama, int sks, String nilaiHuruf) {
        this.nama = nama;
        this.sks = sks;
        this.nilaiHuruf = nilaiHuruf.toUpperCase();
    }

    double getBobot() {
        switch (nilaiHuruf) {
            case "A": return 4.0;
            case "A-": return 3.7;
            case "B+": return 3.3;
            case "B": return 3.0;
            case "B-": return 2.7;
            case "C+": return 2.3;
            case "C": return 2.0;
            case "D": return 1.0;
            case "E": return 0.0;
            default: return 0.0;
        }
    }

    double hitungMutu() {
        return getBobot() * sks;
    }
}

public class HitungIPS {

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        System.out.print("Masukkan jumlah mata kuliah: ");
        int jumlah = input.nextInt();
        input.nextLine();

        MataKuliah[] mk = new MataKuliah[jumlah];

        double totalMutu = 0;
        int totalSKS = 0;

        for (int i = 0; i < jumlah; i++) {

            System.out.println("\nMata Kuliah ke-" + (i+1));

            System.out.print("Nama Mata Kuliah : ");
            String nama = input.nextLine();

            System.out.print("Jumlah SKS : ");
            int sks = input.nextInt();
            input.nextLine();

            System.out.print("Nilai Huruf : ");
            String nilai = input.nextLine();

            mk[i] = new MataKuliah(nama, sks, nilai);

            totalMutu += mk[i].hitungMutu();
            totalSKS += sks;
        }

        double ips = totalMutu / totalSKS;

        System.out.println("\n===== HASIL PERHITUNGAN =====");
        System.out.println("Total SKS : " + totalSKS);
        System.out.println("Total Nilai Mutu : " + totalMutu);
        System.out.println("IPS Semester : " + ips);
    }
}

